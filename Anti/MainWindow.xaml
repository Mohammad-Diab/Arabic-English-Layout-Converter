<Window x:Class="Anti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="335" Width="525">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="83*"/>
            <RowDefinition Height="69*"/>
        </Grid.RowDefinitions>
        <RadioButton x:Name="RadioButton1" Content="English to Arabic" HorizontalAlignment="Left" Margin="10,9,0,0" VerticalAlignment="Top" IsChecked="True"/>
        <RadioButton x:Name="RadioButton4" Content="To Small" HorizontalAlignment="Left" Margin="330,9,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RadioButton3" Content="To Capital" HorizontalAlignment="Left" Margin="250,9,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="RadioButton2" Content="Arabic to English" HorizontalAlignment="Left" Margin="130,9,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TextBox1" Margin="10,35,10,4" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" AutoWordSelection="True" Text="The quick brown jumps over lazy dog 123456789.&#xD;&#xA;من طلب العلا سهر الليالي."/>
        <TextBox x:Name="TextBox2" Margin="10,4,10,7" TextWrapping="Wrap" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" AutoWordSelection="True" IsReadOnly="True"/>
        <Button Content="GO AHEAD" Height="28" Margin="426,4,16,0" VerticalAlignment="Top" Click="Button_Click_1"/>

    </Grid>
</Window>
